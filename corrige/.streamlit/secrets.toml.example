# Modèle de configuration des secrets (à copier en secrets.toml et compléter).
# Le vrai fichier secrets.toml ne doit JAMAIS être versionné.
[mysql]
host = "localhost"
port = 3306
user = "VOTRE_UTILISATEUR"
password = "VOTRE_MOT_DE_PASSE"
database = "fco_db"

# Authentification de l'application (facultatif).
# Sans cette section, l'app utilise les comptes de démonstration
# (admin / labo / eleveur / conseiller, mot de passe : fco2026).
# rôles disponibles : admin (tout) · laboratoire · eleveur · conseiller
[auth.admin]
name = "Administrateur"
role = "admin"
password = "VOTRE_MOT_DE_PASSE"        # en clair (fichier non versionné)

[auth.laborantin]
name = "Jean Dupont"
role = "laboratoire"
password = "VOTRE_MOT_DE_PASSE"

# Paiement des abonnements via Stripe Payment Links (facultatif).
# Ce sont de simples URL publiques https://buy.stripe.com/... : AUCUNE clé
# secrète Stripe ne doit figurer ici ni dans le dépôt.
# Pour les créer : Dashboard Stripe -> Produits -> Payment Links -> créer un
# lien pour un abonnement annuel (120 €/an "Éleveur", 600 €/an "Laboratoire"),
# puis copier l'URL générée ci-dessous. Sans cette section, les boutons
# "S'abonner" s'affichent désactivés (mode démonstration).
[stripe]
eleveur = "https://buy.stripe.com/VOTRE_LIEN_ELEVEUR"
laboratoire = "https://buy.stripe.com/VOTRE_LIEN_LABORATOIRE"

# Assistants (chatbots) — LLM optionnel (facultatif).
# Sans section LLM, les assistants Éleveur et Conseiller fonctionnent avec leur
# base de connaissances (réponses vérifiées, aucune clé requise).
# Avec une clé, ils utilisent en plus un modèle pour des réponses plus
# naturelles (repli automatique sur la base si l'appel échoue).
# NE JAMAIS versionner la vraie clé.
#
# Option A (recommandée, GRATUITE) : Google Gemini — https://aistudio.google.com/apikey
[gemini]
api_key = "AIza_VOTRE_CLE_GEMINI"
# model = "gemini-2.5-flash"   # optionnel (rapide et gratuit par défaut)
#
# Option B : Anthropic Claude (payant) — décommenter pour l'utiliser à la place.
# [anthropic]
# api_key = "sk-ant-VOTRE_CLE_API"
# model = "claude-opus-5"
